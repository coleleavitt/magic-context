{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["bun-types", "../../../plugin/node_modules/@types/node"]
	},
	"include": [
		"*.ts",
		"../../tests/opencode2/*.ts",
		"../../../plugin/src/v2/*.ts"
	]
}
