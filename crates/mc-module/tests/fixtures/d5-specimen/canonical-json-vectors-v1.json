{
  "schema_version": 1,
  "normative_algorithm": [
    {
      "rule": 1,
      "text": "Parse valid JSON while retaining whether every number used integer syntax or fraction/exponent syntax, and emit UTF-8."
    },
    {
      "rule": 2,
      "text": "Sort object keys lexicographically by Unicode code point, never by key length or source order."
    },
    {
      "rule": 3,
      "text": "Use comma and colon separators with no surrounding whitespace."
    },
    {
      "rule": 4,
      "text": "Do not ASCII-escape non-ASCII; escape only quote, backslash, and U+0000-U+001F, using short forms for newline, carriage return, tab, backspace, and form feed and lowercase \\uXXXX for the rest."
    },
    {
      "rule": 5,
      "text": "N1 — Preserve an integer-syntax number as canonical decimal text: no leading + or zeroes, map -0 to 0, and never route arbitrary-magnitude integers through binary64."
    },
    {
      "rule": 6,
      "text": "N2 — Parse a fraction- or exponent-syntax number as finite IEEE-754 binary64 and serialize it with ECMAScript Number::toString (ECMA-262 §6.1.6.1.20 / JSON.stringify): shortest round-trip digits; plain decimal when 1e-6 <= |x| < 1e21, otherwise lowercase exponent notation with + retained for positive exponents; omit an integral fraction and map negative zero to 0."
    },
    {
      "rule": 7,
      "text": "N3 — Apply N1/N2 independently of language-default number formatters; Python re-lays out repr's shortest digits instead of emitting repr directly, and Rust uses ryu-js rather than serde_json Display."
    },
    {
      "rule": 8,
      "text": "Emit no trailing newline."
    }
  ],
  "number_reference": {
    "engine": "Node.js v22.23.1",
    "n1": "Expected integer bytes were obtained with node -e 'BigInt(lexeme).toString()'; BigInt is required because JSON.parse/JSON.stringify loses integers beyond 2^53.",
    "n2": "Expected binary64 bytes were obtained with node -e 'JSON.stringify(Number(lexeme))'."
  },
  "provenance": "hand-written independent canonical-form vectors; the numbered algorithm is normative and these vectors are conformance checks",
